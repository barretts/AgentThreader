{
  "profiles": {
    "default": {
      "steps": [
        {
          "name": "lint",
          "cmd": "npm run lint --if-present",
          "cwd": ".",
          "timeout_sec": 60
        },
        {
          "name": "test",
          "cmd": "npm test --if-present",
          "cwd": ".",
          "timeout_sec": 120
        }
      ],
      "rollback_on_failure": false
    }
  }
}
